# Flask app config
HOST=0.0.0.0
PORT=3001
FLASK_DEBUG=0
SECRET_KEY=please-change
JWT_SECRET_KEY=please-change-too

# OpenAPI docs
API_TITLE=Notes API
API_VERSION=v1
OPENAPI_VERSION=3.0.3
OPENAPI_URL_PREFIX=/docs

# CORS
CORS_ORIGINS=*

# Database connection (provided by notes_database dependency)
# Example for Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/notes
# For local dev fallback (SQLite):
# DATABASE_URL=sqlite:///notes.db
